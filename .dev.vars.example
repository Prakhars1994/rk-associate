# Public config (SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, ENQUIRY_NOTIFY_EMAIL) lives in wrangler.jsonc "vars".
# Secrets go in .dev.vars locally and `npx wrangler secret put <NAME>` in production (never commit real values).
# Optional - enables the email alert to the office:
SENDGRID_API_KEY=
ENQUIRY_FROM_EMAIL=
# Optional - only if the server should write with full access instead of the insert-only publishable key:
SUPABASE_SERVICE_ROLE_KEY=
